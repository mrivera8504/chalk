rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // The single-document playbook, and everything else a coach keeps under
    // their own uid — including the list of other coaches' teams they have
    // joined, at /users/{uid}/teams/{teamId}. Unchanged: a build from before
    // teams still reads and writes here, and the old document stays as the
    // copy to go back to.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // One document per play, under a team.
    //
    // A coach's own team has their uid for its id, so it can be created and
    // found with no lookup. Anyone else has to be on the team document's
    // `members` map. Nobody can put themselves there except with an invite the
    // owner made, and nobody but the owner can put anyone else there or take
    // them off — a member can only take themselves off.
    //
    // Three roles. `owner` is the team's own uid. A `coach` edits everything a
    // coach can see. A `viewer` — a player, a parent — reads the playbook and
    // the team's kit and writes nothing at all.
    match /teams/{teamId} {
      function signedIn() {
        return request.auth != null;
      }
      function isOwner() {
        return signedIn() && request.auth.uid == teamId;
      }
      function isMember() {
        return isOwner() || (signedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/teams/$(teamId)).data.members);
      }
      // A member who may change the playbook: the owner, or a coach.
      function canEdit() {
        return isOwner() || (signedIn() &&
          get(/databases/$(database)/documents/teams/$(teamId)).data.members
            .get(request.auth.uid, '') in ['owner', 'coach']);
      }
      function changed() {
        return request.resource.data.diff(resource.data).affectedKeys();
      }
      // Only these keys of the team document moved, and inside `members` and
      // `names` only the caller's own entry.
      function onlyMyEntry(keys) {
        return changed().hasOnly(keys)
          && request.resource.data.get('members', {}).diff(resource.data.get('members', {}))
               .affectedKeys().hasOnly([request.auth.uid])
          && request.resource.data.get('names', {}).diff(resource.data.get('names', {}))
               .affectedKeys().hasOnly([request.auth.uid]);
      }
      // Joining: the invite names this team, has not run out, and the role
      // taken is the one it offers.
      function joining() {
        let code = request.resource.data.joinedWith;
        let invite = get(/databases/$(database)/documents/invites/$(code)).data;
        return signedIn()
          && !(request.auth.uid in resource.data.get('members', {}))
          && onlyMyEntry(['members', 'names', 'joinedWith', 'updatedAt'])
          && invite.teamId == teamId
          && invite.expiresAt > request.time.toMillis()
          && request.resource.data.members[request.auth.uid] == invite.role;
      }
      function leaving() {
        return signedIn()
          && request.auth.uid != teamId
          && request.auth.uid in resource.data.get('members', {})
          && onlyMyEntry(['members', 'names', 'updatedAt'])
          && !(request.auth.uid in request.resource.data.get('members', {}));
      }

      allow read: if isMember();
      // Only the owner makes their own team, and only with themselves on it.
      allow create: if isOwner()
        && request.resource.data.get('members', {}).keys().hasOnly([teamId]);
      allow update: if isOwner()
        || (canEdit() && !changed().hasAny(['members', 'names', 'ownerUid']))
        || joining()
        || leaving();
      allow delete: if isOwner();

      // What a play may be. Generous — every limit is several times the
      // biggest play a coach has drawn — because a refused write jams the sync
      // for that play. The point is that a bad client cannot fill a document
      // with a megabyte of nonsense, not to police a coach's drawing.
      function playOk() {
        let p = request.resource.data;
        return p.get('players', []).size() <= 100
          && p.get('assignments', []).size() <= 600
          && p.get('annotations', []).size() <= 3000
          && p.get('frames', []).size() <= 50
          && p.get('marks', []).size() <= 200
          && p.get('name', '').size() <= 300
          && p.get('notes', '').size() <= 50000
          && p.get('coachingPoint', '').size() <= 10000;
      }

      // The three collections a team holds, named. A catch-all here would also
      // match the team document itself — in rules version 2 `{document=**}`
      // matches zero segments — which once let any member rewrite `members`.
      // The emulator found that; reading the rules had not.
      match /plays/{playId} {
        allow read: if isMember();
        allow delete: if canEdit();
        allow create, update: if canEdit() && playOk();

        match /revisions/{stamp} {
          allow read: if isMember();
          allow write: if canEdit();
        }
      }
      match /purged/{playId} {
        allow read: if isMember();
        allow write: if canEdit();
      }
      // The team's kit: the roster, the saved formations, the hand-drawn
      // routes, the league rules, the depth chart. One document each, by name,
      // so nothing else can be parked under a team. Capped like a play.
      match /kit/{item} {
        allow read: if isMember();
        allow write: if canEdit()
          && item in ['roster', 'formations', 'routes', 'rules', 'depth']
          && request.resource.data.get('items', []).size() <= 2000;
      }
    }

    // An invite to a team: the link an owner sends an assistant (`coach`), or a
    // player or parent (`viewer`).
    //
    // Like a share link, the code is the protection — read by its exact id,
    // never listed — and it only lets somebody add themselves, as the role it
    // names, to the one team it names, until it runs out. Only a team's owner
    // can make one for it, and only they can take it down.
    match /invites/{code} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null
        && code.size() >= 20
        && request.resource.data.teamId == request.auth.uid
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.role in ['coach', 'viewer'];
      allow update: if false;
      allow delete: if request.auth != null && resource.data.createdBy == request.auth.uid;
    }

    // A frozen copy of a play or a playbook, behind a link.
    //
    // Anybody may read one by its exact token — that is what a link is — and
    // nobody may list them, so the 22-character token is the whole of the
    // protection. Only the account that made one may change or remove it.
    match /shares/{token} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null
        && token.size() >= 20
        && request.resource.data.ownerUid == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;
    }
  }
}
